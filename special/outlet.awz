        for (var i in data.bracelets) {
        	output+="<div class=\"itemcola\"><div class=\"imgcontainer\"><img src=\"" + data.bracelets[i].imgurl + "\"></div><div class=\"subline\"><span class=\"headline\">" + " " + data.bracelets[i].name + "--" + data.bracelets[i].size + "</span><span class=\"sku\">" + data.bracelets[i].code + "</span><?php if($discount==1) {echo "<span class=\\\"crossprice\\\">$ \" + data.bracelets[i].regprice + \"</span>";}else {echo "";} ?><span class=\"regprice\">$ " + <?php if($discount==1) {echo "data.bracelets[i].price";}else {echo "\"Contact us for discount code.\"";} ?>  + "</span></div></div>";
        }
        output+="</div>";
        document.getElementById("placeholder").innerHTML=output;
  });
