    <!-- slider stylesheets -->
    
     
        <link class="rs-file" href="http://www.jewelectric.com/temp/scripts/rs-minimal-white.css" rel="stylesheet">
     
    

    
    <!-- slider css -->
    <style>
    BODY {
	    min-width: 768px;
    }
    @font-face {
		font-family :MyriadPro;
		src: url(/fonts/MyriadPro-Light.otf);
	}
	@font-face {
		font-family: HelveticaNeue;
		src: url(/fonts/HelveticaNeueLTCom-UltLt.ttf);
	}
    #full-width-slider {
	  width: 100%;
	  color: #000;
	}
	.coloredBlock {
	  padding: 12px;
	  background: rgba(255,0,0,0.6);
	  color: #FFF;
	   width: 200px;
	   left: 20%;
	   top: 5%;
	}
	.infoBlock {
	  position: absolute;
	  top: 100px;
	  right: 150px;
	  left: auto;
	  max-width: 25%;
	  padding-bottom: 0;
	  background: rgba(255,255,255,0.1);
	  overflow: hidden;
	  padding: 20px;
	}
	.infoBlockLeftBlack {
	  color: #050505;
	  background: rgba(0,0,0,0.0);
	  left: 30px;
	  right: auto;
	}
	.infoBlock h4 {
	  font-size: 20px;
	  line-height: 1.2;
	  margin: 0;
	  padding-bottom: 3px;
	}
	.infoBlock p {
	  font-size: 14px;
	  margin: 4px 0 0;
	}
	.infoBlock a {
	  color: #FFF;
	  text-decoration: underline;
	}
	.photosBy {
	  position: absolute;
	  line-height: 24px;
	  font-size: 12px;
	  background: #FFF;
	  color: #000;
	  padding: 0px 10px;
	  position: absolute;
	  left: 12px;
	  bottom: 12px;
	  top: auto;
	  border-radius: 2px;
	  z-index: 25; 
	} 
	.photosBy a {
	  color: #000;
	}
	.fullWidth {
	  max-width: 1920px;
	  margin: 0 auto 1px;
	}
	@media screen and (min-width:800px) and (min-height:650px) {
	  .heroSlider .rsOverflow,
	  .royalSlider.heroSlider {
	      height: 650px !important;
	  }
	}
	
	@media screen and (min-width:800px) and (min-height:1000px) {
	    .heroSlider .rsOverflow,
	    .royalSlider.heroSlider {
	        height: 750px !important;
	    }
	    #overhead #companylogo img {
		  width: 80%;
		  height: 80%;
	  }
	}
	@media screen and (min-width: 320px) and (max-width: 768px) {
	  .royalSlider.heroSlider,
	  .royalSlider.heroSlider .rsOverflow {
	    height: 450px !important;
	  }
	  .infoBlock {
	    padding: 10px;
	    height: auto;
	    max-height: 100%;
	    min-width: 40%;
	    left: 5px;
	    top: 5px;
	    right: auto;
	    font-size: 12px;
	  }
	  .infoBlock h3 {
	     font-size: 14px;
	     line-height: 17px;
	  }
	  #main #overhead{
		  height: 160px !important;
	  }
	  #overhead #companylogo img {
		  width: 50%;
		  height: 50%;
	  }
	  #main .bottomcontain {
	  	  width: 100%;
		  height: 166px;
	  }
	  .bottomcontain .cola {
		  display:inline;
		  width: 256px !important;
		  height: 166px !important;
	  }
	  .bottomcontain .colb {
		  display: inline;
		  width: 256px !important;
		  height: 167px !important;
	  }
	  .bottomcontain .colc {
		  display: inline;
		  width: 256px !important; 
		  height: 166px !important;
	  }
	}
	@media screen and (mini-width: 0px) and (max-width: 320px) {
	  .royalSlider.heroSlider,
	  .royalSlider.heroSlider .rsOverflow {
	    height: 300px !important;
	  }
	  .infoBlock {
	    padding: 10px;
	    height: auto;
	    max-height: 100%;
	    min-width: 40%;
	    left: 5px;
	    top: 5px;
	    right: auto;
	    font-size: 12px;
	  }
	  .infoBlock h3 {
	     font-size: 14px;
	     line-height: 17px;
	  }
	  #overhead #companylogo img {
		  width: 30%;
	  }
	  #main .bottomcontain {
	  	  width: 100%;
		  height: 750px;
	  }
	  .bottomcontain .cola {
	  	  display: inline-block;
		  width: 320px;
		  height: 250px !important;
	  }
	  .bottomcontain .colb {
		  display: block;
		  width: 320px;
		  height: 250px !important;
	  }
	  .bottomcontain .colc {
		  display: block;
		  width: 320px;
		  height: 250px !important;
	  }
	}
	
	#main {
			background-color: white;
			width: 100%;
			min-height: 350px;
			position: absolute;
			margin: 0px;
			overflow: hidden;
			text-align: center;
		}
	#main #overhead {
			background-color: rgba(219,219,219,0.36);
			height: 80px;
			width: 100%;
			min-width: 460px;
			position: absolute;
			top: 0;
			left: 0;
			z-index: 1000;
			text-align: left;
			padding-left: 10px;
		}
		
		#overhead #companylogo {
			float: left;
			display: inline;
		}
		#overhead #topmenu {
			display: inline;
			width: 400px;
			height: 70px;
			padding-top: 10px;
		}
		#topmenu ul {
			text-align: left;
			display: inline;
			margin: 0 auto;
			padding: 5px 4px 5px 0;
			list-style: none;
		}
		#topmenu ul li {
		  font: 100 20px/20px MyriadPro;
		  color: #636363;
		  display: inline-block;
		  margin-right: -4px;
		  position: relative;
		  padding: 30px 15px;
		  cursor: pointer;
		  -webkit-transition: all 0.2s;
		  -moz-transition: all 0.2s;
		  -ms-transition: all 0.2s;
		  -o-transition: all 0.2s;
		  transition: all 0.2s;
	 }
	#topmenu ul li:hover {
	  background: rgba(84,84,84,0.30);
	  color: #fff;
	}
	#topmenu ul li ul {
	  padding: 0;
	  position: absolute;
	  top: 80px;
	  left: 0;
	  width: 150px;
	  -webkit-box-shadow: none;
	  -moz-box-shadow: none;
	  box-shadow: none;
	  display: none;
	  opacity: 0;
	  visibility: hidden;
	  -webkit-transiton: opacity 0.2s;
	  -moz-transition: opacity 0.2s;
	  -ms-transition: opacity 0.2s;
	  -o-transition: opacity 0.2s;
	  -transition: opacity 0.2s;
	}
	#topmenu ul li ul li { 
	  background: rgba(84,84,84,0.70); 
	  display: block; 
	  color: #fff;
	  padding: 10px 15px;
	  text-shadow: 0 -1px 0 #000;
	}
	#topmenu ul li ul li:hover { background: #666; }
	#topmenu ul li:hover ul {
	  display: block;
	  opacity: 1;
	  visibility: visible;
	}
	#overhead #CSpanel {
		float: right;
		display: inline;
		width: 200px;
		text-align: right;
		padding-right: 10px;
	}
	#CSpanel ul {
			text-align: left;
			display: inline;
			margin: 0 auto;
			padding: 5px 4px 5px 0;
			list-style: none;
		}
	#CSpanel ul li {
	  font: 100 20px/20px MyriadPro;
	  color: #636363;
	  display: inline-block;
	  margin-right: -4px;
	  position: relative;
	  padding: 30px 15px;
	  cursor: pointer;
	  -webkit-transition: all 0.2s;
	  -moz-transition: all 0.2s;
	  -ms-transition: all 0.2s;
	  -o-transition: all 0.2s;
	  transition: all 0.2s;
	 }
	 li img {
	 width: 20px;
	 height: 20px;
	 }
	 
	 #main .bottomcontain {
	 	 margin-top: 0px;
		 margin-left: auto;
		 margin-right: auto;
		 max-width: 1440px;
		 min-width: 320px;
		 min-height: 250px;
		 overflow: hidden;
		 padding: 0px;
	 }
	 .bottomcontain .cola {
		 float: left;
		 width: calc(100%/3);
		 height: 250px;
		 background-color: rgba(127,123,255,0.97);
		 display: inline;
		 background-image: url(../images/bg_catalog_index.png);
		 background-repeat: no-repeat;
		 background-size: 100% 100%;
	 }
	 .cola img {
		 height: 98%;
		 width: 98%;
	 }
	 .bottomcontain .colb {
	 	float: left;
	 	width: calc(100%/3);
		 height: 250px;
		 background-color: rgba(129,148,255,0.96);
		 display: inline;
		 background-image: url(../images/bg_onlinestore_index.png);
	 }.colb img {
		 height: 98%;
		 width: 98%;
	 }
	 .bottomcontain .colc {
	 		float: right;
	 		width: calc(100%/3);
	 		height: 250px;
	 		background-color: rgba(40, 30, 255, 0.90);
	 		display: inline;
	 		background-image: url(../images/bg_event_index.png);
	 }
	 .colc img {
		 height: 98%;
		 width: 98%;
	 }
	 #main #footer {
		 width: 100%;
		 min-height: 200px;
	 }
	 #footer #footer_content {
		 max-width: 1440px;
		 min-width: 320px;
		 margin-left: auto;
		 margin-right: auto;
		 overflow: auto;
	 }
	 #footer_content .cola {
		 float: left;
		 width: 50%;
		 text-align: left;
	 }
	 #footer_content .colb {
		 float: right;
		 width: 50%;
		 text-align: right;
	 }
	 .footertext {
	 	font: 100 9px/9px MyriadPro;
	 	 margin-left: 10px;
		 font-size: 10pt;
		 margin-right: 10px;
	 }
	
</style>
    
    <style>
      #page-navigation { display: none; }
    </style>
  </head>
  <body>
  	<div id="main">
  	<div id="overhead">
			<!-- header of the page -->
				<div id="companylogo"><img src="images/logo_resize.png" alt="logo"></div>
				<div id="topmenu"><ul>
					<li>Products
						<ul>
							<li>Beads</li>
							<li>Bracelets</li>
							<li>Necklaces</li>
							<li>Silvers</li>
							<li>Others</li>
						</ul>
					</li>
					<li>Events
						<ul>
							<li>Special Event</li>
							<li>Exhibitions</li>
						</ul>
					</li>
					<li>About Us
						<ul>
							<li>Our Company</li>
							<li>Our Goal</li>
							<li>Reach Us</li>
						</ul>
					</li>
					
				</ul>
				</div>
				<div id="CSpanel">
				<ul>
					<li>Login</li>
				</ul>
				</div>
  	</div>
	<!-- slider code start -->
	<div class="sliderContainer fullWidth clearfix">
	<div id="full-width-slider" class="royalSlider heroSlider rsMinW">
	  <div class="rsContent">
	    <img class="rsImg" src="images/hero_01.jpg" alt="Summer sale" />
	    <div class="infoBlock infoBlockLeftBlack rsABlock" data-fade-effect="" data-move-offset="10" data-move-effect="bottom" data-speed="200">
	      <h2>Summer Sales is Back!!!</h2>
	      <p>Click Here to learn more<br></p>
	    </div>
	  </div>
	  <div class="rsContent">
	    <img class="rsImg" src="images/hero_02.jpg" alt="Summer!" />
	     <div class="infoBlock  rsAbsoluteEl" style="color:#0E0E0E;" data-fade-effect="" data-move-offset="10" data-move-effect="bottom" data-speed="200">
	      <h4>Check out the Summer color!!</h4>
	      <p>It's always make you feel summer!</p>
	    </div>
	  </div>
	 <div class="rsContent">
	    <img class="rsImg" src="images/hero_03.jpg" alt="The brand new jewelry" />
	    <div class="infoBlock rsABlock infoBlockLeftBlack" data-fade-effect="" data-move-offset="10" data-move-effect="bottom" data-speed="200">
	      <h4>Vigor Gems and Jewelectric present</h4>
	      <p><a href="http://www.jewelectric.com/">Learn more</a></p>
	    </div>
	  </div>
	  <div class="rsContent">
	    <img class="rsImg" src="images/hero_04.jpg" alt="Gemstones" />
	    <span class="photosBy rsAbsoluteEl" data-fade-effect="fa;se" data-move-offset="40" data-move-effect="bottom" data-speed="200">Fashion Accessories</span>
	  </div>
	</div>
	  </div>
	  <!--slide and menu end-->
	  <div class="bottomcontain">
	  		<div class="cola">
	  		<img src="/images/bg_catalog_text.png" alt="text">
  		 	</div>
  		 	<div class="colb">
  		 	<img src="/images/bg_onlinestore_text.png" alt="store, text">
  		 	</div>
  		 	<div class="colc">
  		 	<img src="/images/bg_event_text.png" alt="events, text">
  		 	</div>
	  </div>
	  <div id="footer">
  		<div id="footer_content">
  		 	<div class="cola"><span class="footertext">Shop and order at our online <a href="http://vgems.co">store</a>, or visit our showroom.</span></div>
  		 	<div class="colb"><span class="footertext">Site Map | Hot News | Our Responsibility | Jobs | Contact Us | </span></div>
  		 	<div class="cola"><span class="footertext">Copyright © 2014 Vigor Gems and Jewelry LTD. All rights reserved. Terms of Use| Privacy Policy</span></div>
  		</div>
	</div>

</div>
<script>
    jQuery(document).ready(function($) {
      // DO NOT INCLUDE THIS CODE IN YOUR BUILD, it's for tabs on this page
        var code = $('#html-code code');
        if(code.is(':empty')) {
          var rsCode = $('.royalSlider-preview');
          if(!rsCode.length) {
              rsCode = $('.royalSlider');
          }
          rsCode = rsCode.clone().removeClass('royalSlider-preview').wrap('<div></div>').parent().html();
          rsCode = htmlencode(rsCode);
          code.html(rsCode);
        }
        $('#js code').html( htmlencode($('#addJS').html()) );

        var filesHTML = '';
        $('.rs-file').each(function() {
          var item = $(this).removeAttr('class');
          if(item.is('script')) {
            filesHTML += '<script src="' + item.attr('src') + '" />';
          } else {
            filesHTML += $('<div>').append( $(this).clone().removeAttr('class') ).html();
          }
          filesHTML += "\n";
        });
        $('#files code').html( htmlencode( filesHTML ) );
        $( ".tabs" ).tabs();
    });
    function htmlencode(str) {
      if(str) {
         return str.replace(/[&<>"']/g, function($0) {
            return "&" + {"&":"amp", "<":"lt", ">":"gt", '"':"quot", "'":"#39"}[$0] + ";";
        });
      }
    }   
  </script>
   
  
    <script id="addJS">jQuery(document).ready(function($) {
  $('#full-width-slider').royalSlider({
    arrowsNav: true,
    loop: true,
    keyboardNavEnabled: true,
    controlsInside: false,
    imageScaleMode: 'fill',
    arrowsNavAutoHide: false,
    autoScaleSlider: true, 
    autoScaleSliderWidth: 960,     
    autoScaleSliderHeight: 350,
    controlNavigation: 'bullets',
    thumbsFitInViewport: false,
    navigateByClick: true,
    startSlideId: 0,
    autoPlay: true,
    transitionType:'move',
    globalCaption: false,
    deeplinking: {
      enabled: true,
      change: false
    },
    /* size of all images http://help.dimsemenov.com/kb/royalslider-jquery-plugin-faq/adding-width-and-height-properties-to-images */
    imgWidth: 1800,
    imgHeight: 750
  });
});
</script>

  </body>
</html>
